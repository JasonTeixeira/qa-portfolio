ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apk upgrade --no-cache \
  && apk add --no-cache \
    bash \
    coreutils \
    python3 \
    sqlite-libs \
  && command -v python3 >/dev/null \
  && command -v bash >/dev/null \
  && command -v timeout >/dev/null \
  && mkdir -p /vercel/sandbox \
  && chmod 1777 /vercel/sandbox

WORKDIR /vercel/sandbox
